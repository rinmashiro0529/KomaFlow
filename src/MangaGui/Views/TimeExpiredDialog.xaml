<views:AppContentDialog x:Class="MangaGui.Views.TimeExpiredDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                       xmlns:views="clr-namespace:MangaGui.Views"
                       Title="{Binding HeadlineText}"
                       DialogMaxWidth="480"
                       Padding="0"
                       IsFooterVisible="False">
    <views:AppContentDialog.Resources>
        <Style TargetType="{x:Type views:TimeExpiredDialog}"
               BasedOn="{StaticResource {x:Type ui:ContentDialog}}" />
    </views:AppContentDialog.Resources>

    <StackPanel>
        <Border Padding="8,4"
                Margin="0,0,0,8"
                HorizontalAlignment="Left"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <ui:TextBlock FontTypography="Caption"
                          FontWeight="SemiBold"
                          Text="{Binding BadgeText}" />
        </Border>
        <TextBlock TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding SummaryText}" />

        <!-- Billing-safe accent action first; "稍后提醒" is equivalent to Esc. -->
        <ui:Button x:Name="DrainButton"
                   HorizontalAlignment="Stretch"
                   Margin="0,0,0,8"
                   Content="{Binding DrainButtonText}"
                   Visibility="{Binding IsDrainVisible, Converter={StaticResource BoolToVis}}"
                   Click="OnDrainClick" />
        <ui:Button x:Name="ExtendButton"
                   HorizontalAlignment="Stretch"
                   Margin="0,0,0,8"
                   Content="{Binding ExtendButtonText}"
                   Click="OnExtendClick" />
        <ui:Button x:Name="StopNowButton"
                   HorizontalAlignment="Stretch"
                   Margin="0,0,0,8"
                   Content="{Binding StopNowButtonText}"
                   Click="OnStopNowClick" />
        <ui:Button x:Name="RemindLaterButton"
                   HorizontalAlignment="Stretch"
                   Content="{Binding RemindLaterButtonText}"
                   Click="OnRemindLaterClick" />

        <ui:TextBlock FontTypography="Caption"
                      Margin="0,8,0,0"
                      TextWrapping="Wrap"
                      Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                      Text="{Binding CountdownText}" />
    </StackPanel>
</views:AppContentDialog>
