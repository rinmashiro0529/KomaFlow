<views:AppContentDialog x:Class="MangaGui.Views.DiagnosticsDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                       xmlns:views="clr-namespace:MangaGui.Views"
                       Title="环境诊断与协议信息"
                       DialogMaxWidth="720"
                       CloseButtonText="关闭">
    <views:AppContentDialog.Resources>
        <Style TargetType="{x:Type views:DiagnosticsDialog}"
               BasedOn="{StaticResource {x:Type ui:ContentDialog}}" />
    </views:AppContentDialog.Resources>

    <StackPanel>
        <ui:TextBlock x:Name="SubtitleTextBlock"
                      FontTypography="Caption"
                      Margin="0,0,0,8"
                      FontFamily="Cascadia Mono, Consolas"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBox x:Name="DiagnosticsTextBox"
                 Height="320"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Content="复制脱敏诊断"
                       Click="OnCopyClick" />
            <ui:TextBlock x:Name="StatusTextBlock"
                          Grid.Column="1"
                          FontTypography="Caption"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
        </Grid>
    </StackPanel>
</views:AppContentDialog>
