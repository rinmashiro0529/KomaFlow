<ui:FluentWindow x:Class="MangaGui.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:MangaGui.Models"
                 Title="漫画翻译 · Colab"
                 Icon="pack://application:,,,/MangaGui;component/Assets/app.ico"
                 Width="900"
                 Height="680"
                 MinWidth="640"
                 MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 AllowDrop="True"
                 DragEnter="OnWindowDragEnter"
                 DragOver="OnWindowDragOver"
                 DragLeave="OnWindowDragLeave"
                 Drop="OnWindowDrop"
                 PreviewKeyDown="OnWindowPreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ① Title bar with the "more" menu -->
        <ui:TitleBar Grid.Row="0" Title="漫画翻译 · Colab">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/MangaGui;component/Assets/app.ico" Width="18" Height="18" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
                <ui:DropDownButton x:Name="MoreButton"
                                   HorizontalAlignment="Right"
                                   Appearance="Transparent"
                                   AutomationProperties.Name="更多"
                                   DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                   WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:DropDownButton.Icon>
                        <ui:SymbolIcon Symbol="MoreHorizontal24" />
                    </ui:DropDownButton.Icon>
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <ui:MenuItem Header="主题">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="DarkTheme24" />
                                </ui:MenuItem.Icon>
                                <ui:MenuItem Header="跟随系统"
                                             IsCheckable="True"
                                             IsChecked="{Binding PlacementTarget.DataContext.ThemePreference, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource EnumMatchToBool}, ConverterParameter=System, Mode=OneWay}"
                                             Command="{Binding PlacementTarget.DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                             CommandParameter="{x:Static models:ThemePreference.System}" />
                                <ui:MenuItem Header="浅色"
                                             IsCheckable="True"
                                             IsChecked="{Binding PlacementTarget.DataContext.ThemePreference, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Light, Mode=OneWay}"
                                             Command="{Binding PlacementTarget.DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                             CommandParameter="{x:Static models:ThemePreference.Light}" />
                                <ui:MenuItem Header="深色"
                                             IsCheckable="True"
                                             IsChecked="{Binding PlacementTarget.DataContext.ThemePreference, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Dark, Mode=OneWay}"
                                             Command="{Binding PlacementTarget.DataContext.SetThemeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                             CommandParameter="{x:Static models:ThemePreference.Dark}" />
                            </ui:MenuItem>
                            <ui:MenuItem Header="翻译引擎"
                                         IsEnabled="{Binding PlacementTarget.DataContext.CanChangeEngine, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Mode=OneWay}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Translate24" />
                                </ui:MenuItem.Icon>
                                <ui:MenuItem Header="新引擎 mtui（默认，仅日文）"
                                             IsCheckable="True"
                                             IsChecked="{Binding PlacementTarget.DataContext.EnginePreference, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Mtui, Mode=OneWay}"
                                             Command="{Binding PlacementTarget.DataContext.SetEngineCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                             CommandParameter="{x:Static models:TranslationEngineChoice.Mtui}" />
                                <ui:MenuItem Header="旧引擎 mit（英文 / 泰文）"
                                             IsCheckable="True"
                                             IsChecked="{Binding PlacementTarget.DataContext.EnginePreference, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource EnumMatchToBool}, ConverterParameter=Mit, Mode=OneWay}"
                                             Command="{Binding PlacementTarget.DataContext.SetEngineCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                             CommandParameter="{x:Static models:TranslationEngineChoice.Mit}" />
                            </ui:MenuItem>
                            <Separator />
                            <ui:MenuItem Header="Colab 账号与额度…"
                                         Command="{Binding PlacementTarget.DataContext.OpenAccountsDialogCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Wrench24" />
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <ui:MenuItem Header="自动按剩余额度轮询"
                                         IsCheckable="True"
                                         IsChecked="{Binding PlacementTarget.DataContext.IsAutoAccountMode, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Mode=OneWay}"
                                         IsEnabled="{Binding PlacementTarget.DataContext.CanSwitchAccount, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Mode=OneWay}"
                                         Command="{Binding PlacementTarget.DataContext.SetAutoAccountModeCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            <ui:MenuItem Header="刷新全部账号额度"
                                         Command="{Binding PlacementTarget.DataContext.RefreshQuotasCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <Separator />
                            <ui:MenuItem Header="环境检查与修复…" Command="{Binding PlacementTarget.DataContext.OpenEnvironmentCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            <ui:MenuItem Header="选择脚本目录…"
                                         Command="{Binding PlacementTarget.DataContext.BrowseScriptsFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Folder24" />
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <ui:MenuItem Header="复查云端会话"
                                         InputGestureText="F5"
                                         Command="{Binding PlacementTarget.DataContext.ReprobeSessionCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" />
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                            <ui:MenuItem Header="诊断信息…"
                                         Command="{Binding PlacementTarget.DataContext.ShowDiagnosticsCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                <ui:MenuItem.Icon>
                                    <ui:SymbolIcon Symbol="Info24" />
                                </ui:MenuItem.Icon>
                            </ui:MenuItem>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Page content + drag overlay; disabled while a dialog is showing -->
        <Grid x:Name="PageContent" Grid.Row="1">
            <Grid MaxWidth="960" Margin="24,16,24,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ② Persistent notices (InfoBars, fixed priority order) -->
                <StackPanel Grid.Row="0">
                    <Grid Visibility="{Binding HasErrorBanner, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Error"
                                    Title="会话错误"
                                    Message="{Binding ErrorBannerText}"
                                    IsOpen="{Binding HasErrorBanner}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Assertive" />
                        <ui:Button Grid.Column="1"
                                   Content="查看原始输出"
                                   Command="{Binding ViewLastErrorLogCommand}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <Grid Visibility="{Binding HasPersistenceWarning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Warning"
                                    Title="计费保护提示"
                                    Message="{Binding PersistenceWarningText}"
                                    IsOpen="{Binding HasPersistenceWarning}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Assertive" />
                        <ui:Button Grid.Column="1"
                                   Content="立即复查"
                                   Command="{Binding ReprobeSessionCommand}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <!-- Secondary account orphan billing warning -->
                    <Grid Visibility="{Binding HasOtherAccountWarning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Warning"
                                    Title="其他账号计费告警"
                                    Message="{Binding OtherAccountWarningText}"
                                    IsOpen="{Binding HasOtherAccountWarning}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Assertive" />
                        <ui:Button Grid.Column="1"
                                   Content="停止此账号的 manga"
                                   Command="{Binding StopOtherAccountSessionCommand}"
                                   Visibility="{Binding CanStopOtherAccount, Converter={StaticResource BoolToVis}}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <!-- Active account low CU balance warning -->
                    <Grid Visibility="{Binding HasLowBalanceWarning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <ui:InfoBar Severity="Warning"
                                    Title="账号余额偏低"
                                    Message="{Binding LowBalanceWarningText}"
                                    IsOpen="{Binding HasLowBalanceWarning}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <Grid Visibility="{Binding IsFiveMinuteWarningVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Warning"
                                    Title="剩余不足 5 分钟"
                                    Message="{Binding FiveMinuteWarningText}"
                                    IsOpen="{Binding IsFiveMinuteWarningVisible, Mode=TwoWay}"
                                    IsClosable="True"
                                    AutomationProperties.LiveSetting="Polite" />
                        <ui:Button Grid.Column="1"
                                   Content="延长 30 分钟"
                                   Command="{Binding Extend30MinutesCommand}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <Grid Visibility="{Binding IsQueuePaused, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Warning"
                                    Title="队列已暂停"
                                    Message="{Binding QueuePauseReason}"
                                    IsOpen="{Binding IsQueuePaused}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Polite" />
                        <ui:Button Grid.Column="1"
                                   Content="恢复队列"
                                   Command="{Binding ResumeQueueCommand}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>

                    <!-- Engine mismatch: configured engine differs from the live session's engine. -->
                    <Grid Visibility="{Binding HasEngineMismatch, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <ui:InfoBar Severity="Informational"
                                    Title="引擎不一致"
                                    Message="{Binding EngineMismatchText}"
                                    IsOpen="{Binding HasEngineMismatch}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Polite" />
                    </Grid>

                    <Grid Visibility="{Binding HasEnvironmentWarning, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:InfoBar Severity="Warning"
                                    Title="环境检查"
                                    Message="{Binding EnvironmentWarning}"
                                    IsOpen="{Binding HasEnvironmentWarning}"
                                    IsClosable="False"
                                    AutomationProperties.LiveSetting="Polite" />
                        <ui:Button Grid.Column="1"
                                   Content="环境检查与修复…"
                                   Command="{Binding OpenEnvironmentCommand}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>

                <!-- ③ Session card -->
                <ui:Card Grid.Row="1" Margin="0,8,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Row 1: status + primary actions -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Top">
                                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True">
                                    <ui:ProgressRing.Style>
                                        <Style TargetType="ui:ProgressRing"
                                               BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProbingStartup}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Deploying">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Stopping">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="AutoStopping">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:ProgressRing.Style>
                                </ui:ProgressRing>
                                <ui:SymbolIcon FontSize="20">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Symbol" Value="Circle24" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProbingStartup}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Deploying">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Stopping">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="AutoStopping">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Ready">
                                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding SessionState}" Value="Ready" />
                                                        <Condition Binding="{Binding IsHealthDisconnected}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Symbol" Value="PlugDisconnected24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Busy">
                                                    <Setter Property="Symbol" Value="ArrowSync24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Draining">
                                                    <Setter Property="Symbol" Value="HourglassHalf24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SessionState}" Value="Error">
                                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ui:TextBlock FontTypography="BodyStrong"
                                              Text="{Binding RuntimeBadgeText}"
                                              AutomationProperties.LiveSetting="Polite" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding StatusDetailText}"
                                              TextWrapping="Wrap"
                                              MaxHeight="32"
                                              ToolTip="{Binding StatusDetailText}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Primary"
                                           Content="启动服务"
                                           Command="{Binding StartServiceCommand}"
                                           IsEnabled="{Binding CanStartService}"
                                           Visibility="{Binding CanStartService, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.Name="启动服务">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Appearance="Primary"
                                           Content="重试部署"
                                           Command="{Binding RetryDeployCommand}"
                                           IsEnabled="{Binding CanRetryDeploy}"
                                           Visibility="{Binding CanRetryDeploy, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.Name="重试部署"
                                           Margin="8,0,0,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="+30 分钟"
                                           Command="{Binding Extend30MinutesCommand}"
                                           IsEnabled="{Binding CanExtendTime}"
                                           Visibility="{Binding CanExtendTime, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.Name="延长 30 分钟"
                                           Margin="8,0,0,0" />
                                <ui:Button Content="停止并结束计费"
                                           Command="{Binding StopServiceCommand}"
                                           IsEnabled="{Binding CanStopService}"
                                           Visibility="{Binding HasActiveVm, Converter={StaticResource BoolToVis}}"
                                           AutomationProperties.Name="停止并结束计费"
                                           Margin="8,0,0,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Stop24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: multi-account quota strip & quick switch -->
                        <Grid Grid.Row="1"
                              Margin="0,12,0,0"
                              Visibility="{Binding HasAccountManager, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Content="{Binding AccountModeSummary}"
                                           Command="{Binding SetAutoAccountModeCommand}"
                                           IsEnabled="{Binding CanSwitchAccount}"
                                           Appearance="Transparent"
                                           Padding="8,4"
                                           Margin="0,0,8,0"
                                           ToolTip="点击切换为「自动按剩余额度轮询」模式（运行中锁定）"
                                           AutomationProperties.Name="账号选号模式" />

                                <ItemsControl ItemsSource="{Binding AccountBadges}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Command="{Binding DataContext.SelectManualAccountCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                       CommandParameter="{Binding Id}"
                                                       IsEnabled="{Binding DataContext.CanSwitchAccount, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                       ToolTip="{Binding TooltipText}"
                                                       Padding="8,4"
                                                       Margin="0,0,8,0"
                                                       AutomationProperties.Name="{Binding CompactLabel}">
                                                <ui:Button.Style>
                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                        <Setter Property="Appearance" Value="Secondary" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActiveOwner}" Value="True">
                                                                <Setter Property="Appearance" Value="Primary" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRecommendedOrSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon FontSize="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                                        <ui:SymbolIcon.Style>
                                                            <Style TargetType="ui:SymbolIcon">
                                                                <Setter Property="Symbol" Value="Circle24" />
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActiveOwner}" Value="True">
                                                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLowBalance}" Value="True">
                                                                        <Setter Property="Symbol" Value="Warning24" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsErrorOrExpired}" Value="True">
                                                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ui:SymbolIcon.Style>
                                                    </ui:SymbolIcon>
                                                    <ui:TextBlock FontTypography="Caption"
                                                                  Text="{Binding CompactLabel}"
                                                                  VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ProgressRing Width="16"
                                                 Height="16"
                                                 IsIndeterminate="True"
                                                 Margin="0,0,4,0"
                                                 Visibility="{Binding IsRefreshingQuotas, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Appearance="Transparent"
                                           Command="{Binding RefreshQuotasCommand}"
                                           ToolTip="刷新所有启用账号的剩余 CU 额度"
                                           AutomationProperties.Name="刷新账号额度"
                                           Margin="0,0,4,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Appearance="Transparent"
                                           Content="账号管理"
                                           Command="{Binding OpenAccountsDialogCommand}"
                                           ToolTip="添加、切换、管理 Colab 账号与额度轮询策略"
                                           AutomationProperties.Name="管理 Colab 账号" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: billing readout -->
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <WrapPanel Orientation="Horizontal" Visibility="{Binding HasActiveVm, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon FontSize="16" Margin="0,0,4,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon.Style>
                                        <Style TargetType="ui:SymbolIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BillingSeverity}" Value="Warning">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BillingSeverity}" Value="Danger">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:SymbolIcon.Style>
                                </ui:SymbolIcon>
                                <ui:TextBlock FontTypography="Subtitle"
                                              Text="{Binding ElapsedDisplay}"
                                              VerticalAlignment="Center">
                                    <ui:TextBlock.Style>
                                        <Style TargetType="ui:TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BillingSeverity}" Value="Warning">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding BillingSeverity}" Value="Danger">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:TextBlock.Style>
                                </ui:TextBlock>
                                <ui:TextBlock FontTypography="Body"
                                              Text="{Binding BillingCuDisplay}"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center" />
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding BillingPolicyDisplay}"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center" />
                            </WrapPanel>
                            <ui:TextBlock FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{Binding IdleBillingHintText}"
                                          Visibility="{Binding HasActiveVm, Converter={StaticResource InverseBoolToVis}}" />
                        </Grid>

                        <!-- Row 3: progress bars -->
                        <StackPanel Grid.Row="3" Margin="0,8,0,0">
                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding BillingProgressPercent, Mode=OneWay}"
                                         Visibility="{Binding IsTimedMode, Converter={StaticResource BoolToVis}}"
                                         AutomationProperties.Name="计费时长进度">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar"
                                           BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding BillingSeverity}" Value="Warning">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding BillingSeverity}" Value="Danger">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <Grid Margin="0,8,0,0" Visibility="{Binding IsDeploying, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ui:TextBlock FontTypography="Caption"
                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                              Text="{Binding DeployStageText}" />
                                <ProgressBar Grid.Row="1"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding DeployProgressPercent, Mode=OneWay}"
                                             Margin="0,4,0,0"
                                             AutomationProperties.Name="部署进度" />
                            </Grid>
                        </StackPanel>

                        <!-- Row 4: service details (collapsed) -->
                        <ui:CardExpander Grid.Row="4" Margin="0,8,0,0" IsExpanded="False">
                            <ui:CardExpander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="Body" Text="服务详情" />
                                    <ui:TextBlock Grid.Column="1"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding HealthStatusDisplay}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                </Grid>
                            </ui:CardExpander.Header>
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="Body" Text="llama-server（核心）:6006" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon FontSize="16" Margin="0,0,4,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Circle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LlamaHealthy}" Value="True">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHealthDisconnected}" Value="True">
                                                            <Setter Property="Symbol" Value="PlugDisconnected24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <ui:TextBlock FontTypography="Caption" VerticalAlignment="Center">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Setter Property="Text" Value="未就绪" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LlamaHealthy}" Value="True">
                                                            <Setter Property="Text" Value="正常" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsHealthDisconnected}" Value="True">
                                                            <Setter Property="Text" Value="失联" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="Body" Text="mit API（可选）:8001" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon FontSize="16" Margin="0,0,4,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Circle24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MitHealthy}" Value="True">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <ui:TextBlock FontTypography="Caption" VerticalAlignment="Center">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Setter Property="Text" Value="未启用" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MitHealthy}" Value="True">
                                                            <Setter Property="Text" Value="正常" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                        </ui:TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock FontTypography="Body" Text="GPU 显存" VerticalAlignment="Center" />
                                    <ui:TextBlock Grid.Column="1"
                                                  FontTypography="Caption"
                                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  Text="{Binding GpuInfoDisplay}"
                                                  TextWrapping="Wrap"
                                                  VerticalAlignment="Center" />
                                </Grid>
                                <ui:Button Content="复查会话"
                                           Command="{Binding ReprobeSessionCommand}"
                                           ToolTip="立即调用 colab sessions 核实云端会话状态（F5）"
                                           HorizontalAlignment="Left">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </ui:CardExpander>
                    </Grid>
                </ui:Card>

                <!-- ④ Task section header + commands -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBlock FontTypography="BodyStrong" Text="任务" VerticalAlignment="Center" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding Tasks.Count, StringFormat={}{0} 个}"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="添加"
                                   Command="{Binding AddFilesCommand}"
                                   IsEnabled="{Binding IsDropZoneActive}"
                                   ToolTip="添加漫画压缩包（Ctrl+O）"
                                   AutomationProperties.Name="添加">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:DropDownButton Content="输出位置" Margin="8,0,0,0">
                            <ui:DropDownButton.Icon>
                                <ui:SymbolIcon Symbol="Folder24" />
                            </ui:DropDownButton.Icon>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <ui:MenuItem Header="更改输出目录…"
                                                 Command="{Binding PlacementTarget.DataContext.SelectOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <ui:MenuItem Header="恢复为原文件目录"
                                                 Command="{Binding PlacementTarget.DataContext.ResetOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                 IsEnabled="{Binding PlacementTarget.DataContext.HasCustomOutputDirectory, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                        <ui:DropDownButton Content="清理" Margin="8,0,0,0">
                            <ui:DropDownButton.Icon>
                                <ui:SymbolIcon Symbol="Broom24" />
                            </ui:DropDownButton.Icon>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu>
                                    <ui:MenuItem Header="清空已完成"
                                                 Command="{Binding PlacementTarget.DataContext.ClearCompletedTasksCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <ui:MenuItem Header="清空失败与已取消"
                                                 Command="{Binding PlacementTarget.DataContext.ClearFailedTasksCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>
                </Grid>

                <!-- Output dir / precheck caption -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <ui:TextBlock FontTypography="Caption"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                  Text="{Binding OutputDirectoryDisplay}"
                                  TextTrimming="CharacterEllipsis"
                                  ToolTip="{Binding OutputDirectoryDisplay}">
                        <ui:TextBlock.Style>
                            <Style TargetType="ui:TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrechecking}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropZoneActive}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:TextBlock.Style>
                    </ui:TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPrechecking}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDropZoneActive}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ui:ProgressRing Width="14" Height="14" IsIndeterminate="True" Margin="0,0,4,0" VerticalAlignment="Center">
                            <ui:ProgressRing.Style>
                                <Style TargetType="ui:ProgressRing"
                                       BasedOn="{StaticResource {x:Type ui:ProgressRing}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPrechecking}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:ProgressRing.Style>
                        </ui:ProgressRing>
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="{Binding DropZonePromptText}"
                                      TextTrimming="CharacterEllipsis"
                                      ToolTip="{Binding DropZonePromptText}"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- ④ Task list + empty state -->
                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <ui:ListView x:Name="TaskListView"
                                 ItemsSource="{Binding Tasks}"
                                 SelectionMode="Extended"
                                 Visibility="{Binding HasTasks, Converter={StaticResource BoolToVis}}">
                        <ui:ListView.ItemContainerStyle>
                            <Style TargetType="ui:ListViewItem"
                                   BasedOn="{StaticResource {x:Type ui:ListViewItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- Tag carries the window-level view model so the context menu's
                                     MenuItems can reach the task commands from the popup's
                                     separate visual tree (PlacementTarget.DataContext is the item). -->
                                <Setter Property="Tag"
                                        Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}" />
                                <Setter Property="AutomationProperties.Name">
                                    <Setter.Value>
                                        <MultiBinding Mode="OneWay" StringFormat="{}{0}，{1}">
                                            <Binding Path="FileName" Mode="OneWay" />
                                            <Binding Path="StatusDisplay" Mode="OneWay" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu>
                                            <ui:MenuItem Header="打开所在位置"
                                                         Command="{Binding PlacementTarget.Tag.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         Visibility="{Binding PlacementTarget.DataContext.IsCompleted, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BoolToVis}}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Folder24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="从头重试"
                                                         Command="{Binding PlacementTarget.Tag.RetryTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         Visibility="{Binding PlacementTarget.DataContext.CanRetry, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BoolToVis}}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="查看失败日志"
                                                         Command="{Binding PlacementTarget.Tag.ViewTaskLogCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         Visibility="{Binding PlacementTarget.DataContext.CanViewLog, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BoolToVis}}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="DocumentText24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                            <ui:MenuItem Header="移除"
                                                         Command="{Binding PlacementTarget.Tag.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                         Visibility="{Binding PlacementTarget.DataContext.CanRemove, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BoolToVis}}">
                                                <ui:MenuItem.Icon>
                                                    <ui:SymbolIcon Symbol="Dismiss24" />
                                                </ui:MenuItem.Icon>
                                            </ui:MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <EventSetter Event="PreviewMouseRightButtonDown"
                                             Handler="OnTaskItemPreviewMouseRightButtonDown" />
                                <EventSetter Event="MouseDoubleClick"
                                             Handler="OnTaskItemMouseDoubleClick" />
                            </Style>
                        </ui:ListView.ItemContainerStyle>
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Top">
                                        <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        <ui:SymbolIcon FontSize="20">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Symbol" Value="Clock24" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                            <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Symbol" Value="ErrorCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Symbol" Value="DismissCircle24" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                    </Grid>

                                    <StackPanel Grid.Column="1">
                                        <ui:TextBlock FontTypography="Body"
                                                      Text="{Binding FileName}"
                                                      TextTrimming="CharacterEllipsis"
                                                      ToolTip="{Binding SourceZipPath}" />
                                        <ui:TextBlock FontTypography="Caption"
                                                      TextTrimming="CharacterEllipsis">
                                            <ui:TextBlock.Style>
                                                <Style TargetType="ui:TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:TextBlock.Style>
                                            <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                                            <Run Text="{Binding DetailHint, Mode=OneWay, StringFormat=' · {0}', TargetNullValue=''}" />
                                        </ui:TextBlock>
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Margin="0,4,0,0"
                                                     Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                     AutomationProperties.Name="{Binding FileName, StringFormat={}翻译进度 {0}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Appearance="Transparent"
                                                   Content="移除"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.Name="{Binding FileName, StringFormat={}移除 {0}}" />
                                        <ui:Button Appearance="Transparent"
                                                   Content="从头重试"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding DataContext.RetryTaskCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.Name="{Binding FileName, StringFormat={}重试 {0}}" />
                                        <ui:Button Appearance="Transparent"
                                                   Content="查看日志"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding DataContext.ViewTaskLogCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding CanViewLog, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.Name="{Binding FileName, StringFormat={}查看日志 {0}}" />
                                        <ui:Button Appearance="Transparent"
                                                   Content="打开位置"
                                                   Margin="8,0,0,0"
                                                   Command="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"
                                                   AutomationProperties.Name="{Binding FileName, StringFormat={}打开位置 {0}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVis}}">
                        <ui:SymbolIcon Symbol="FolderZip24"
                                       FontSize="40"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <ui:TextBlock FontTypography="Body"
                                      Text="把漫画 .zip / .cbz 或文件夹拖到这里"
                                      HorizontalAlignment="Center"
                                      Margin="0,12,0,0" />
                        <ui:TextBlock FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="也可以按 Ctrl+O 选择文件。添加时先做离线预检，不会产生计费。"
                                      HorizontalAlignment="Center"
                                      Margin="0,4,0,0" />
                        <ui:Button Content="选择文件…"
                                   Command="{Binding AddFilesCommand}"
                                   IsEnabled="{Binding IsDropZoneActive}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ⑤ Log area (collapsed by default) -->
                <ui:CardExpander x:Name="LogExpander" Grid.Row="5" Margin="0,16,0,16" IsExpanded="False">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBlock FontTypography="Body" Text="运行日志" VerticalAlignment="Center" />
                            <ui:TextBlock Grid.Column="1"
                                          FontTypography="Caption"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                          Text="{Binding LatestLogLine}"
                                          TextTrimming="CharacterEllipsis"
                                          Margin="16,0,0,0"
                                          VerticalAlignment="Center" />
                            <ui:Button Grid.Column="2"
                                       Content="复制全部"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Click="OnCopyAllLogsClick"
                                       Visibility="{Binding IsExpanded, ElementName=LogExpander, Converter={StaticResource BoolToVis}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </Grid>
                    </ui:CardExpander.Header>
                    <ui:ListView x:Name="LogListBox"
                                 Height="200"
                                 SelectionMode="Extended"
                                 ItemsSource="{Binding Logs}">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon FontSize="12" Margin="0,0,4,0" VerticalAlignment="Top">
                                        <ui:SymbolIcon.Style>
                                            <Style TargetType="ui:SymbolIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Symbol" Value="Warning24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:SymbolIcon.Style>
                                    </ui:SymbolIcon>
                                    <ui:TextBlock FontTypography="Caption"
                                                  FontFamily="Cascadia Mono, Consolas"
                                                  Text="{Binding FormattedLine}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </ui:TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                </ui:CardExpander>
            </Grid>

            <!-- Drag & drop overlay -->
            <Border IsHitTestVisible="False"
                    Background="{DynamicResource SmokeFillColorDefaultBrush}"
                    Visibility="{Binding IsDragOver, Converter={StaticResource BoolToVis}}">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="8"
                        Padding="24"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Add24" FontSize="24" Margin="0,0,8,0" />
                        <ui:TextBlock FontTypography="BodyStrong"
                                      Text="松开以添加到队列"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- Transient notices render above the page content but below in-window dialogs (spec 10.1) -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter"
                              Grid.Row="1"
                              VerticalAlignment="Bottom" />

        <!-- Dialog host: in-window ContentDialogs render here, covering everything below the title bar -->
        <ContentPresenter x:Name="DialogHost" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
