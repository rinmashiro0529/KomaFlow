<views:AppContentDialog x:Class="MangaGui.Views.LogViewerDialog"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                       xmlns:views="clr-namespace:MangaGui.Views"
                       Title="日志详情"
                       DialogMaxWidth="720"
                       CloseButtonText="关闭">
    <views:AppContentDialog.Resources>
        <Style TargetType="{x:Type views:LogViewerDialog}"
               BasedOn="{StaticResource {x:Type ui:ContentDialog}}" />
    </views:AppContentDialog.Resources>

    <StackPanel>
        <ui:TextBlock FontTypography="Caption"
                      Margin="0,0,0,8"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      Text="末尾最多 100 行输出" />
        <TextBox x:Name="LogTextBox"
                 Height="320"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Mono, Consolas"
                 FontSize="12" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="复制脱敏日志"
                           Margin="0,0,8,0"
                           Click="OnCopyRedactedClick" />
                <ui:Button Appearance="Transparent"
                           Content="复制原文"
                           Click="OnCopyRawClick" />
            </StackPanel>
            <ui:TextBlock x:Name="CopyStatusTextBlock"
                          Grid.Column="1"
                          FontTypography="Caption"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
        </Grid>
    </StackPanel>
</views:AppContentDialog>
